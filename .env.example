# Configure NEAR AI Cloud API key
# Get yours at https://cloud.near.ai
NEARAI_CLOUD_API_KEY=<YOUR-API-KEY>

# Optional overrides
# MODEL_NAME=zai-org/GLM-5.1-FP8   # any TEE-hosted model from https://docs.near.ai/cloud/models
# STREAM=true                      # stream the chat response (signature_kind becomes "gateway")
